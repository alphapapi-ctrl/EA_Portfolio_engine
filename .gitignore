# Environments
.venv/
__pycache__/
*.pyc

# Private data — raw set files and Strategy Tester reports stay local.
# The compiled timeline database (aggregated trades/daily P&L) IS committed.
reports_in/*
!reports_in/.gitkeep
timeline/test_partial/
runs/*
!runs/.gitkeep
# Example runs ship with the repo — name a run "example_..." to include it
!runs/example_*/
reference/*
!reference/.gitkeep
excluded/

# OS noise
Thumbs.db
.DS_Store

# Local teaching snapshot (pre-real-tick OHLC compile), not for clones
timeline/main_pool_2018_ohlc/

# proxy_3m_realticks ships with the repo as base data; other proxy_* stay local
timeline/proxy_*/
!timeline/proxy_3m_realticks/
